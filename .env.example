# ============================================================
# AI Jewelry Virtual Try-On - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values

# ============================================================
# YouCam API (Primary Try-On Provider)
# Get your API key at: https://developer.youcam.com
# ============================================================
YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_API_SECRET=your_youcam_api_secret_here
YOUCAM_API_BASE_URL=https://api.youcam.com/v1

# ============================================================
# Fashn.ai API (Alternative Try-On Provider)
# Get your API key at: https://fashn.ai
# ============================================================
FASHN_API_KEY=your_fashn_api_key_here
FASHN_API_BASE_URL=https://api.fashn.ai/v1

# ============================================================
# Replicate API (Fallback - Open Source Models)
# Get your API key at: https://replicate.com
# ============================================================
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ============================================================
# AWS S3 (Optional - for persistent image storage)
# ============================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=jewelry-tryon-images

# ============================================================
# NextAuth (Optional - for user authentication)
# ============================================================
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# App Configuration
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================================
# Active Provider Selection
# Options: youcam | fashn | replicate | demo
# Use "demo" for testing without API keys
# ============================================================
TRYON_PROVIDER=demo
